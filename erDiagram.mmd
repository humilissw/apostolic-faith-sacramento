erDiagram
%% ||: One and only one.
%% |{: One or many.
%% O{: Zero or many.
%% O|: Zero or one.

    %% Core domain entities
    USER ||--|{ USER_SCOPE : has
    USER ||--o{ REFRESH_TOKEN : owns
    USER ||--o{ PAYMENT : donates
    USER ||--o{ VIDEO_UPLOAD : creates
    USER ||--o{ MEDIA : owns
    USER ||--o{ CLIENT_CREDENTIALS : owns

    MEDIA ||--|{ VIDEO_UPLOAD : associated
    CHURCH_SERVICE ||--o{ MEDIA : produces
    MEMBER ||--|| USER : linked

    PAYMENT ||--o| DONATION_CONFIG : references
    INTEGRATION_CONFIG ||--o{ MEDIA : syncs

    %% Users
    USER {
        string id PK "UUID"
        string email UK
        string hashed_password
        bool is_active
        bool is_superuser
        string full_name
        datetime created_on
        datetime updated_on
    }

    USER_SCOPE {
        string id PK "UUID"
        string user_id FK
        string scope
        datetime created_on
    }

    REFRESH_TOKEN {
        string id PK "UUID"
        string user_id FK
        string token UK
        bool revoked
        datetime expires_at
        datetime created_on
    }

    CLIENT_CREDENTIALS {
        string id PK "UUID"
        string client_id UK
        string client_secret_hash
        string scopes
        bool is_active
        datetime created_on
    }

    AUTHORIZATION_CODE {
        string id PK "UUID"
        string code UK
        string client_id
        string code_challenge
        string redirect_uri
        bool used
        datetime expires_at
        datetime created_on
    }

    %% Media
    MEDIA {
        string id PK "UUID"
        string name
        string owner_id FK
        datetime uploaded_on
        datetime created_on
        datetime updated_on
    }

    VIDEO_UPLOAD {
        string id PK "UUID"
        string owner_id FK
        string upload_location
        string upload_name
        datetime media_association_date
        string speaker_name
        string reference_text
        string description
        datetime created_on
        datetime updated_on
    }

    %% Church
    MEMBER {
        string id PK "UUID"
        string first_name
        string last_name
        datetime birthday
        datetime wedding_anniversary
        datetime baptism_date
        datetime created_on
        datetime updated_on
    }

    CHURCH_SERVICE {
        string id PK "UUID"
        datetime service_date
        string speaker
        string service_title
        string file_location
        bool edited
        bool uploaded
        datetime created_on
        datetime updated_on
    }

    ANNOUNCEMENT {
        string id PK "UUID"
        string sender
        string recipients
        string message
        datetime created_on
        datetime updated_on
    }

    %% Payments
    PAYMENT {
        string id PK "UUID"
        int amount_cents
        string currency
        string status
        string stripe_payment_intent_id UK
        string stripe_subscription_id
        string donor_email
        string donor_name
        string receipt_url
        string metadata_json
        datetime created_on
        datetime updated_on
    }

    DONATION_CONFIG {
        string id PK "UUID"
        string label
        int amount_cents
        bool is_default
        string frequency
        datetime created_on
        datetime updated_on
    }

    %% Integrations
    INTEGRATION_CONFIG {
        string id PK "UUID"
        string type UK
        string display_name
        string icon
        bool enabled
        string status
        datetime last_synced_at
        string config_json
        string cred_key_id
        string cred_encrypted_iv
        string cred_encrypted_blob
        datetime created_on
        datetime updated_on
    }

    %% Legacy / utility
    ITEM {
        int id PK
        string owner_id FK
        string title
        string description
        datetime created_on
        datetime updated_on
    }
