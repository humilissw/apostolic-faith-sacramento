[
  {
    "label": "Python: FastAPI",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "uvicorn",
    "autoStartBrowser": true,
    "cwd": "$ZED_WORKTREE_ROOT/src/be",
    "envFile": "${ZED_WORKTREE_ROOT}/src/be/.env",
    "autoReload": {
      "enable": true
    },
    "args": [
      "app.main:app",
      "--reload",
      "--ssl-certfile=security_keys/cert.pem",
      "--ssl-keyfile=security_keys/cert_key.pem"
    ],
    "jinja": true
  },
  {
    "label": "Python: FastAPI",
    "adapter": "JavaScript",
    "command": "bun https",
    "name": "Run bun https",
    "request": "launch",
    "type": "node-terminal"
  }
]
