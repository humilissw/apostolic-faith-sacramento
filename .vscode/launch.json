{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch via bun",
      "request": "launch",
      "runtimeArgs": ["dev"],
      "runtimeExecutable": "bun",
      "cwd": "${workspaceFolder}/src/fe",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "Launch via npm",
      "request": "launch",
      "cwd": "${workspaceFolder}/src/fe",
      "runtimeArgs": ["run", "dev"],
      "runtimeExecutable": "npm",
      "skipFiles": ["<node_internals>/**"],
      "type": "node"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "AFC Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "autoStartBrowser": true,
      "envFile": "${workspaceFolder}/src/be/.env",
      "autoReload": {
        "enable": true
      },
      "args": [
        "app.main:app",
        "--reload",
        "--ssl-certfile=${workspaceFolder}/infrastructure/certs/cert.pem",
        "--ssl-keyfile=${workspaceFolder}/infrastructure/certs/key.pem"
      ],
      "jinja": true
    }
  ]
}
