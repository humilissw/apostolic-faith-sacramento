# EditorConfig for Apostolic Faith Sacramento
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_size = 4
max_line_length = 100
# Match black formatting
[*.pyi]
indent_size = 4
max_line_length = 100

# Markdown files
[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yaml,yml}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# HTML files
[*.{html,htm}]
indent_size = 2

# CSS files
[*.css]
indent_size = 2

# JavaScript files
[*.{js,jsx,ts,tsx}]
indent_size = 2

# TOML files
[*.{toml,tml}]
indent_size = 2

# SQL files
[*.sql]
indent_size = 2

# Docker files
[Dockerfile*]
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab

# Git config
[.gitconfig]
indent_style = space
indent_size = 4