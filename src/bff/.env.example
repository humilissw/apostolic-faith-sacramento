# --- Upstream FastAPI backend --------------------------------------------- #
# Base URL of the backend (no trailing slash needed).
BACKEND_URL=https://localhost:8000
# Verify the backend TLS cert. Set false ONLY for self-signed loopback dev certs.
BACKEND_VERIFY=true
# Optional CA bundle path used to verify a self-signed/enterprise backend cert.
# BACKEND_CA_BUNDLE=/app/security_keys/ca.pem

# --- SPA ------------------------------------------------------------------- #
# Comma-separated (or JSON array) list of allowed SPA origins for CORS.
SPA_ORIGINS=https://localhost:3000
# Base URL the browser is redirected to after login (carries ?code=...).
SPA_URL=https://localhost:3000

# --- Session / signing ----------------------------------------------------- #
# REQUIRED in production. Signs the session cookie and one-time auth codes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
SESSION_COOKIE_NAME=bff_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# --- Auth ------------------------------------------------------------------ #
# Lifetime (seconds) of the one-time login code handed to the SPA.
AUTH_CODE_TTL_SECONDS=120

# --- Server ---------------------------------------------------------------- #
BFF_HOST=0.0.0.0
BFF_PORT=8002
BFF_CERTFILE=security_keys/cert.pem
BFF_KEYFILE=security_keys/key.pem
BACKEND_TIMEOUT=30
