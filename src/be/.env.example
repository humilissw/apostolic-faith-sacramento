# Database Configuration
DB_SERVER=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_DB=your_database
CERT_FILE=security_keys/cert.pem
CERT_KEY=security_keys/cert_key.pem
RSA_PUB_KEY=security_keys/public_key.pem
RSA_PRIVATE_KEY=security_keys/private_dec.pem

# Environment
ENVIRONMENT=local

# Application
FRONTEND_HOST=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000
PROJECT_NAME=AFC Sacramento Backend
STACK_NAME=afc-sacramento

# Security
SECRET_KEY=your-secret-key-here-generate-one-securely
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Configuration
EMAIL_TEST_USER=test@example.com
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=AFC Sacramento
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
EMAILS_ENABLED=false

# Sentry (optional)
SENTRY_DSN=

# Docker
DOCKER_IMAGE_BACKEND=your-docker-image:tag
DOCKER_IMAGE_FRONTEND=your-frontend-image:tag

# Auth0 (optional)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Development
DEBUG=false

# Testing
TEST_DATABASE_URL=mysql+asyncmy://test_user:test_password@localhost:3306/test_db
