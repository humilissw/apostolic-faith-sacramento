# Email microservice -- CONTAINER DEFAULT configuration.
# This file is REQUIRED by docker-compose.yml (email service env_file).
# It holds safe local/container defaults; real secrets live in .env.local /
# .env.prod (git-ignored), selected per environment via ENVIRONMENT.
# To run outside compose: cp .env.local .env  (then adjust as needed)

PROJECT_NAME=Apostolic Faith Sacramento
# 'local' also makes app/config.py overlay .env.local when present.
ENVIRONMENT=local
VERSION=0.1.0

# SMTP delivery (default: local mailcatcher, plaintext, no auth)
SMTP_HOST=mailcatcher
SMTP_PORT=1025
SMTP_TLS=False
SMTP_SSL=False
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@afc.local
EMAILS_FROM_NAME=Apostolic Faith Sacramento

# Links embedded in emails
FRONTEND_HOST=https://localhost:3000
EMAIL_RESET_TOKEN_EXPIRE_HOURS=1

# Auth (verification only; tokens are issued by src/be/)
RSA_PUB_KEY=security_keys/public_key.pem
JWT_ISSUER=
# Must match the backend's JWT_AUDIENCE (tokens carry aud=<backend value>);
# empty skips audience verification.
JWT_AUDIENCE=https://localhost:8000
EMAIL_REQUIRED_SCOPE=api:email
SERVICE_API_KEY=

# Shared application DB (read-only users table)
# 'database' resolves inside the compose network; creds come from the
# docker-compose environment block (local) or .env.prod (production).
DB_SERVER=database
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DB=afc_sac

# Service-owned delivery tracking DB
TRACKING_DB_URL=sqlite:////app/data/email_delivery.db
